{
  "name": "@zcode/zcode-cua",
  "version": "0.6.6",
  "private": true,
  "description": "Source-built KCode Computer Use runtime and native macOS Helper",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./frame-contract": {
      "types": "./frame-contract.d.ts",
      "import": "./frame-contract.js"
    },
    "./host-display-contract": {
      "types": "./host-display-contract.d.ts",
      "import": "./host-display-contract.js"
    },
    "./request-access-contract": {
      "types": "./request-access-contract.d.ts",
      "import": "./request-access-contract.js"
    },
    "./pip-session": {
      "types": "./pip-session.d.ts",
      "import": "./pip-session.js"
    },
    "./pip-session/node": {
      "types": "./pip-session-node.d.ts",
      "import": "./pip-session-node.js"
    },
    "./broker": {
      "types": "./broker.d.ts",
      "import": "./broker.js"
    },
    "./broker/server": {
      "types": "./broker-server.d.ts",
      "import": "./broker-server.js"
    },
    "./broker/in-process": {
      "types": "./broker-in-process.d.ts",
      "import": "./broker-in-process.js"
    },
    "./broker/ports": {
      "types": "./broker-ports.d.ts",
      "import": "./broker-ports.js"
    },
    "./broker/socketPath": {
      "types": "./broker-socket-path.d.ts",
      "import": "./broker-socket-path.js"
    },
    "./broker/helperConstants": {
      "types": "./broker-helper-constants.d.ts",
      "import": "./broker-helper-constants.js"
    },
    "./broker/helperHealth": {
      "types": "./broker-helper-health.d.ts",
      "import": "./broker-helper-health.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "test": "node --test test/*.test.mjs && vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@noble/hashes": "1.8.0",
    "sharp": "0.34.5"
  },
  "zcodeCuaProducer": {
    "kind": "source",
    "protocol": 3,
    "platforms": [
      "darwin"
    ],
    "nativeBuild": "scripts/build-native.mjs"
  }
}
